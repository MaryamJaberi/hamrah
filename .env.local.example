# ---------- required ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- video (Jitsi) ----------
# meet.jit.si limits embedded calls to 5 minutes. For real use, point this at
# your own Jitsi server or a JaaS (8x8.vc/<tenant>) domain.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ---------- web push: npx web-push generate-vapid-keys ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- native push (FCM HTTP v1) ----------
FCM_PROJECT_ID=
# the service-account JSON, on one line
FCM_SERVICE_ACCOUNT_JSON=

# ---------- payments ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# platform commission in percent
PLATFORM_FEE_PERCENT=15

# ---------- SMS OTP ----------
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=hamrah-otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# dev only: print OTP codes to the server log instead of sending SMS
SMS_DEV_LOG=true

# ---------- KYC (Persona, optional) ----------
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# ---------- maps (optional — default is free OpenStreetMap, no key) ----------
# MapTiler tiles (free tier 100k loads/month): https://cloud.maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=
# Google Places (New) for venue search — paid beyond Google's monthly credit
GOOGLE_PLACES_KEY=
# «دورهمی» venue search (free, no card): https://myprojects.geoapify.com → create project → API key
GEOAPIFY_KEY=

# ---------- E2E tests only (never set in production) ----------
E2E_TEST_SECRET=

# Test bots (test database only) — see supabase/seed/bots.sql, scripts/bots.mjs, e2e/bots.spec.ts
BOT_PASSWORD=
